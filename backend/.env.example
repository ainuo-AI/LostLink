# 应用基础信息：这些值会显示在 OpenAPI 文档和健康检查响应中。
APP_NAME=LostLink API
APP_VERSION=0.1.0
APP_ENV=local

# API 与跨域配置：JSON 数组格式便于 Pydantic 正确解析多个前端地址。
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# 本地数据库：示例账号仅用于开发环境，生产环境必须使用独立强密码和密钥管理。
MYSQL_DATABASE=lostlink
MYSQL_USER=lostlink_app
MYSQL_PASSWORD=lostlink_local
MYSQL_ROOT_PASSWORD=lostlink_root_local
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://lostlink_app:lostlink_local@127.0.0.1:3306/lostlink?charset=utf8mb4

# 认证策略：会话默认 7 天；连续 5 次失败后锁定登录 15 分钟。
AUTH_SESSION_TTL_HOURS=168
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_LOCK_MINUTES=15

# 图片上传：文件保存在应用受控目录，单张默认最多 5MB。
UPLOAD_DIRECTORY=var/uploads
UPLOAD_MAX_BYTES=5242880

# OpenAI 兼容图文匹配：模型必须支持 image_url 图片输入。
# BASE_URL 为 API 根地址（可含 /v1），不要填写 /chat/completions。
# 密钥只填写到本地 .env；开关默认关闭，不会调用外部服务。
MATCHING_AI_ENABLED=false
MATCHING_AI_BASE_URL=https://api.deepseek.com
MATCHING_AI_API_KEY=
MATCHING_AI_MODEL=deepseek-flash
MATCHING_AI_TIMEOUT_SECONDS=30
MATCHING_AI_MAX_CANDIDATES=5
MATCHING_AI_WEIGHT=0.6
MATCHING_AI_MAX_IMAGE_BYTES=5242880
